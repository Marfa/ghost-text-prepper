GHOST_URL=https://your-site.ghost.io
GHOST_ADMIN_API_KEY=id:hex_secret_placeholder

# Hugging Face — primary excerpt provider (must start with hf_)
HF_TOKEN=hf_xxx
HF_TEXT_MODEL=openai/gpt-oss-20b

# Groq — fallback when HF fails / credits depleted (optional if HF_TOKEN set)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# BotHub — cover image for scheduled posts without feature_image (optional; skip if unset)
# Prefer Eco key for covers (cheaper); Pro only if you need max speed/reliability
BOTHUB_API_KEY=
BOTHUB_BASE_URL=https://bothub.chat/api/v2/openai/v1
# Nano Banana 2 (BotHub name) — API model id:
BOTHUB_IMAGE_MODEL=gemini-3.1-flash-image

MAX_EXCERPT_LEN=146
# Skip scheduled posts that already have custom_excerpt (1/0)
SKIP_COMPLETE=1
# Skip scheduled posts that already have feature_image (1/0)
SKIP_COVER_COMPLETE=1
# Re-upload PNG covers as real .jpg for Telegram OG (1/0)
FIX_TELEGRAM_OG=1
STATE_FILE=state/last-run.json
