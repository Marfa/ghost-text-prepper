GHOST_URL=https://your-site.ghost.io
GHOST_ADMIN_API_KEY=id:hex_secret_placeholder

# Social cross-post (optional — python app.py --social)
# RU site falls back to GHOST_URL / GHOST_ADMIN_API_KEY when unset
GHOST_URL_RU=https://ru.example.com
GHOST_ADMIN_API_KEY_RU=id:hex_secret_placeholder
GHOST_URL_EN=https://en.example.com
GHOST_ADMIN_API_KEY_EN=id:hex_secret_placeholder
SOCIAL_STATE_FILE=state/social-last-run.json

# X (Twitter) — OAuth 1.0a, separate app per locale
X_RU_API_KEY=
X_RU_API_SECRET=
X_RU_ACCESS_TOKEN=
X_RU_ACCESS_TOKEN_SECRET=
X_EN_API_KEY=
X_EN_API_SECRET=
X_EN_ACCESS_TOKEN=
X_EN_ACCESS_TOKEN_SECRET=

# VK — community wall (VK_OWNER_ID negative, e.g. -123456789)
VK_ACCESS_TOKEN=
VK_OWNER_ID=-123456789

# LinkedIn — author URN (urn:li:organization:… or urn:li:person:…)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:123456

# Pinterest — board id for new pins
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Hugging Face — excerpt only (must start with hf_)
HF_TOKEN=hf_xxx
HF_TEXT_MODEL=openai/gpt-oss-20b

MAX_EXCERPT_LEN=146
# Skip drafts that already have custom_excerpt (1/0)
SKIP_COMPLETE=1
STATE_FILE=state/last-run.json
